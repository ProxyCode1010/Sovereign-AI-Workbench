# Database Configuration
DATABASE_URL=postgresql://sw_user:sw_pass@postgres:5432/sovereign_workbench

# Ollama Host & Local Models
OLLAMA_HOST=http://host.docker.internal:11434
GENERAL_MODEL=qwen2.5:1.5b-instruct
CODE_MODEL=qwen2.5-coder:1.5b
VISION_MODEL=moondream:1.8b
EMBED_MODEL=nomic-embed-text

# Docker Sandbox Settings
HOST_SANDBOX_DIR_ABS=C:/Users/DELL/OneDrive/Desktop/Sovereign AI Workbench/data/sandbox_tmp

# LangSmith Observability Configuration
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=sovereign-ai-workbench
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
